      "protocol": "MedKLIP Section3.5: unseen disease description appended to the original entity query set; shared classifier and released checkpoint unchanged.",
      "native_example": "https://github.com/hieuvmphan/CVPR2024_MAVL/blob/main/Zero-shot_classification/configs/covid_medklip.yaml"
    },
    "label_mapping": {
      "covid": "covid19",
      "covid-19": "covid19",
      "pneumonia": "eumonia",
      "no finding": "normal",
      "no findings": "normal",
      "enlarged cardiomediastinum": "enlarge",
      "lung opacity": "opacity",
      "lung lesion": "lesion",
      "pleural effusion": "effusion",
      "infiltration": "infiltrate",
      "fibrosis": "tail_abnorm_obs",
      "pleural thickening": "thicken",
      "pleural_thickening": "thicken",
      "lung mass": "mass",
      "lung nodule": "nodule",
      "support devices": "device"
    },
    "author_key_correction": "Official JSON key eumonia is the pneumonia query at index20 in author test.py; its original description and sequence position are unchanged.",
    "limitations": [
      "TB/Granuloma queries lack verified author definitions in this frozen protocol; these tasks are rejected. This is a description-resource/protocol limitation, not an architectural closed-vocabulary restriction.",
      "Fibrosis uses author CXR14 mapping tail_abnorm_obs, a broad abnormality concept."
    ],
    "original_code": "baselines/MedKLIP/Sample_zero-shot_Classification_CXR14/test.py",
    "grounding": {
      "source": "baselines/MedKLIP/Sample_Zero-Shot_Grounding_RSNA/test.py",
      "method": "mean of four cross-attention layers, 14x14 grid repeated16 to224 as author; nearest inverse-resize to full original image extent",
      "values": "raw attention, no minmax normalization",
      "crop": false
    }
  },
